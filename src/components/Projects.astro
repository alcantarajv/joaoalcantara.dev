		flex-wrap: wrap;
		gap: 6px 10px;
		align-items: center;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
		margin: 0 0 40px;
		padding: 0;
		list-style: none;
	}

	.arc li {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.arc li + li::before {
		content: '→';
		color: var(--faint);
	}

	.arc a {
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}

	.arc a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.project {
		padding-block: 8px 0;
		scroll-margin-top: 72px;
	}

	.project + .project {
		margin-top: 48px;
		padding-top: 48px;
		border-top: 1px dashed var(--rule);
	}

	.project__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 14px;
		margin-bottom: 18px;
	}

	.project__name {
		font-family: var(--display);
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		margin: 0;
	}

	.project__focus {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.project__status {
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 3px 8px;
		white-space: nowrap;
	}

	.question {
		font-family: var(--display);
		font-size: 1.1rem;
		font-weight: 400;
		font-style: italic;
		color: var(--muted);
		border-left: 2px solid var(--accent);
		padding-left: 16px;
		margin: 0 0 20px;
		max-width: var(--measure);
	}

	pre {
		font-family: var(--mono);
		font-size: 12.5px;
		line-height: 1.6;
		background: var(--surface);
		border: 1px solid var(--rule);
		padding: 14px 16px;
		overflow-x: auto;
		margin: 0 0 20px;
		color: var(--ink);
	}

	pre .c {
		color: var(--faint);
	}

	pre .k {
		color: var(--accent);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0 0 18px;
		padding: 0;
		list-style: none;
	}

	.chips li {
		font-family: var(--mono);
		font-size: 11.5px;
		color: var(--muted);
		border: 1px solid var(--rule);
		padding: 3px 9px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		font-family: var(--mono);
		font-size: 13px;
	}

	.links a {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.18s ease;
	}

	.links a:hover {
		border-bottom-color: var(--accent);
	}
</style>
