---
// Seção de projetos da home, gerada a partir de src/content/projetos/.
// Adicionar um projeto é criar um arquivo .md lá; nada aqui precisa mudar.
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import { projetosPublicados } from '../lib/projetos';

const projetos = await projetosPublicados();
---

<Section id="projetos" label="Projetos">
	<ul class="arc" aria-label="Sequência dos projetos">
		{
			projetos.map((projeto) => (
				<li>
					<a href={`#${projeto.id}`}>{projeto.data.foco}</a>
				</li>
			))
		}
	</ul>

	{projetos.map((projeto) => <ProjectCard projeto={projeto} />)}
</Section>

<style>
	.arc {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
		align-items: center;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
		margin: 0 0 40px;
		padding: 0;
		list-style: none;
	}

	.arc li {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.arc li + li::before {
		content: '→';
		color: var(--faint);
	}

	.arc a {
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}

	.arc a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
</style>
