---
import { CURRICULO, EMAIL, GITHUB, LINKEDIN, LOCAL, NOME } from '../consts';
---

<header class="hero">
	<p class="eyebrow">{LOCAL}</p>
	<h1>{NOME}</h1>
	<p class="lede">
		Desenvolvedor <strong>backend</strong>. Construo APIs em <strong>Java</strong> e <strong>Spring Boot</strong> — com
		atenção ao que costuma quebrar depois: latência, concorrência e consistência entre sistemas.
	</p>
	<div class="actions">
		<a class="btn btn--primary" href={`mailto:${EMAIL}`}>Falar comigo</a>
		<a class="btn" href={GITHUB} target="_blank" rel="noopener">
			GitHub<span class="sr-only"> (abre em nova aba)</span>
		</a>
		<a class="btn" href={LINKEDIN} target="_blank" rel="noopener">
			LinkedIn<span class="sr-only"> (abre em nova aba)</span>
		</a>
		<a class="btn" href={CURRICULO} target="_blank" rel="noopener">
			Currículo (PDF)<span class="sr-only"> (abre em nova aba)</span>
		</a>
	</div>
</header>

<style>
	.hero {
		padding-block: clamp(64px, 10vw, 104px) 56px;
	}

	.eyebrow {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin: 0 0 20px;
	}

	h1 {
		font-family: var(--display);
		font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.035em;
		text-wrap: balance;
		margin: 0 0 24px;
	}

	.lede {
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
		color: var(--muted);
		max-width: 56ch;
		margin: 0 0 32px;
	}

	.lede strong {
		color: var(--ink);
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--mono);
		font-size: 13px;
		text-decoration: none;
		padding: 9px 16px;
		border: 1px solid var(--rule);
		background: transparent;
		color: var(--ink);
		transition:
			border-color 0.18s ease,
			color 0.18s ease,
			background-color 0.18s ease;
	}

	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.btn--primary {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--ground);
	}

	.btn--primary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--ground);
	}
</style>
